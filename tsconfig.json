{
  // Covers the supplied harness (spec/, scripts/) plus src/ (TypeScript
  // backend only — src/public/**/*.js is plain browser JS, left out
  // implicitly since tsc only resolves .ts/.tsx under `include` by default).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  },
  "include": ["*.ts", "spec", "scripts", "src"]
}
