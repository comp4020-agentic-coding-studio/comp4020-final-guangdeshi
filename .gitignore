node_modules/
dist/
*.log

# Buy or Pass's local runtime state: the SQLite database and uploaded
# images (fly.toml points these at /data in production; locally they land
# here), plus local screenshot/test output. None of this is source.
data/
screenshots/
playwright-report/
test-results/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
